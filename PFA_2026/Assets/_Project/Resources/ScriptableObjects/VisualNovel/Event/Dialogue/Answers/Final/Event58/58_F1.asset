  <ButtonText>k__BackingField: "Jennie est responsable de piloter le navire, les
    autres ont le droit d\u2019\xEAtre insatisfaits."
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 44ec2a6625f7a934dab5754819bfeb2e, type: 2}
