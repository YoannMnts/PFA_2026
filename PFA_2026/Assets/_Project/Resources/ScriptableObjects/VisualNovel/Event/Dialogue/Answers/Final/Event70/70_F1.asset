  m_EditorClassIdentifier: Naussilus.Core::Naussilus.Core.VisualNovels.EventDatas.DialogueDatas.Answers.FinalAnswerData
  <ButtonText>k__BackingField: "Ca n\u2019existe pas les krakens volants, pas d'inqui\xE9tude"
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 6d7f1579677957f4989c5da3f93a4c8d, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 368af27e801a8f643a3763179d93db07, type: 2}
    <Text>k__BackingField:
    - "Ah bon ? Mais je l\u2019ai vu dans plein de livres pourtant !"
    - "\xC7a ne vous inqui\xE8te vraiment pas ?"
  - <Npc>k__BackingField: {fileID: 11400000, guid: 6d7f1579677957f4989c5da3f93a4c8d, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: f0358eca1d351f540a61dc689202b2b8, type: 2}
    <Text>k__BackingField:
    - "Je reste quand m\xEAme sur mes gardes au cas o\xF9."
  <Effects>k__BackingField:
  - <IsEnumeration>k__BackingField: 0
    <CurrentNpcTarget>k__BackingField:
      rid: -2
    <Conditions>k__BackingField: []
