  m_EditorClassIdentifier: Naussilus.Core::Naussilus.Core.VisualNovels.EventDatas.DialogueDatas.Answers.FinalAnswerData
  <ButtonText>k__BackingField: "Ynna tu dois rendre \xE0 Herlock ce qu\u2019il a
    perdu \xE0 cause de toi."
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 292bca25009c3b846973697c392c826a, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 15a032d1f64921b49a6cec6c0a26887d, type: 2}
    <Text>k__BackingField:
    - "Merci mon capitaine, j\u2019savais que j\u2019pouvais compter sur vous !"
    - "Vous devriez nous r\u2019joindre un de ces jours pour disputer quelques parties
      ! \r\n"
  - <Npc>k__BackingField: {fileID: 11400000, guid: c468415a02cbf74438a48816b0fe1fa6, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 368af27e801a8f643a3763179d93db07, type: 2}
    <Text>k__BackingField:
    - "Jamais je n\u2019accepterais un manque de respect comme \xE7a ! "
    - "Vous devriez plut\xF4t lui apprendre les bonnes mani\xE8res !"
