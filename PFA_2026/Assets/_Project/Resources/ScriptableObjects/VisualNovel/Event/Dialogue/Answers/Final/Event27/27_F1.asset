  <ButtonText>k__BackingField: "Je suis d\xE9sol\xE9, je ne peux rien faire pour
    son cas, tu dois t\u2019y habituer"
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 668c08530be223b44883e3880f11ee48, type: 2}
