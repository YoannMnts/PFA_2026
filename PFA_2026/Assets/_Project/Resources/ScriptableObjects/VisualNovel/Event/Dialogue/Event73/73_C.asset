  <Lines>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 3d35d0e1530830e42b12a5e80d0329dc, type: 2}
    <Text>k__BackingField:
    - "Mon lit douillet ! Et ma maison en g\xE9n\xE9ral, mes fr\xE8res et soeurs,
      et les plats de ma maman."
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 15a032d1f64921b49a6cec6c0a26887d, type: 2}
    <Text>k__BackingField:
    - "Et j\u2019ai une petite amie aussi ! "
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 368af27e801a8f643a3763179d93db07, type: 2}
    <Text>k__BackingField:
    - "J\u2019ai h\xE2te de la revoir. J\u2019esp\xE8re qu\u2019elle m\u2019a pas
      oubli\xE9 depuis le temps.\r\n"
