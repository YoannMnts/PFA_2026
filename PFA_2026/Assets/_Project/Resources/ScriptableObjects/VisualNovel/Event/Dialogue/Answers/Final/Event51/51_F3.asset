  m_Name: 51_F3
  m_EditorClassIdentifier: Naussilus.Core::Naussilus.Core.VisualNovels.EventDatas.DialogueDatas.Answers.FinalAnswerData
  <ButtonText>k__BackingField: "Tu as eu tort de lui parler comme \xE7a Camil, maintenant
    tu dois en assumer les cons\xE9quences.\r\n"
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 44ec2a6625f7a934dab5754819bfeb2e, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 368af27e801a8f643a3763179d93db07, type: 2}
    <Text>k__BackingField:
    - "Je vais exploser, j\u2019ai peur !\r\n"
  - <Npc>k__BackingField: {fileID: 11400000, guid: d57cec67bb2a1a945ada3b66d3cb9bf5, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 3973df86522e4b743879172e3518e737, type: 2}
    <Text>k__BackingField:
    - "Arr\xEAte de brailler !"
  - <Npc>k__BackingField: {fileID: 11400000, guid: d57cec67bb2a1a945ada3b66d3cb9bf5, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 15a032d1f64921b49a6cec6c0a26887d, type: 2}
    <Text>k__BackingField:
    - "Je vais v\xE9rifier tes radiateurs, mais j\u2019esp\xE8re que \xE7a t\u2019a
      servi de le\xE7on et que tu ne recommencera pas."
  - <Npc>k__BackingField: {fileID: 11400000, guid: 44ec2a6625f7a934dab5754819bfeb2e, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 15a032d1f64921b49a6cec6c0a26887d, type: 2}
    <Text>k__BackingField:
    - "Ouf, merci T\xE9a ! "
