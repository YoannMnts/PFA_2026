  <ButtonText>k__BackingField: "Je pense que tu as encore beaucoup \xE0 apprendre
    avant de rentrer chez toi."
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 3973df86522e4b743879172e3518e737, type: 2}
    <Text>k__BackingField:
    - "Oh ! Oh non dites pas \xE7a, vous pensez que je manque encore d'exp\xE9rience
      ?"
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 368af27e801a8f643a3763179d93db07, type: 2}
    <Text>k__BackingField:
    - "\xC7a veut dire que je suis pas pr\xE8s de rentrer\u2026"
    - "Ca me d\xE9prime.\r\n"
