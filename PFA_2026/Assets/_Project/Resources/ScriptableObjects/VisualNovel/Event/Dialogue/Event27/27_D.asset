  <Lines>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 668c08530be223b44883e3880f11ee48, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 368af27e801a8f643a3763179d93db07, type: 2}
    <Text>k__BackingField:
    - "Et bien la cuisine est toujours en bazar, les repas sont servis en retard,
      la table n\u2019est pas d\xE9barrass\xE9e avant des heures\u2026"
  - <Npc>k__BackingField: {fileID: 11400000, guid: 668c08530be223b44883e3880f11ee48, type: 2}
