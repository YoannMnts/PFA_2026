  m_EditorClassIdentifier: Naussilus.Core::Naussilus.Core.VisualNovels.EventDatas.DialogueDatas.Answers.FinalAnswerData
  <ButtonText>k__BackingField: "Jennie est parfaite comme elle est, et tu devrais
    apprendre \xE0 la conna\xEEtre pour t\u2019en rendre compte."
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: f0358eca1d351f540a61dc689202b2b8, type: 2}
    <Text>k__BackingField:
    - "Je la connais pas vraiment et j\u2019ai pas plus envie que \xE7a de la conna\xEEtre."
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 15a032d1f64921b49a6cec6c0a26887d, type: 2}
    <Text>k__BackingField:
    - "Mais maintenant que vous le dites, je suis un peu curieux de savoir comment
      elle \xE0 eu son poulpe\u2026"
    - "Peut \xEAtre que je devrais aller la voir."
