  m_EditorClassIdentifier: Naussilus.Core::Naussilus.Core.VisualNovels.EventDatas.DialogueDatas.Answers.FinalAnswerData
  <ButtonText>k__BackingField: "Tout le monde \xE0 la m\xEAme valeur sur ce navire.\r\n"
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: c468415a02cbf74438a48816b0fe1fa6, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 3973df86522e4b743879172e3518e737, type: 2}
    <Text>k__BackingField:
    - "Ah\u2026Vous pensez ?"
    - "Enfin je veux dire, pour moi la valeur est quelque chose qui se prouve et
      se gagne\u2026"
    - "Je ne savais pas que vous voyiez les choses de cette fa\xE7on."
    - "Je vais\u2026"
  - <Npc>k__BackingField: {fileID: 11400000, guid: c468415a02cbf74438a48816b0fe1fa6, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 15a032d1f64921b49a6cec6c0a26887d, type: 2}
    <Text>k__BackingField:
    - "Je vais reconsid\xE9rer mon avis sur lui."
