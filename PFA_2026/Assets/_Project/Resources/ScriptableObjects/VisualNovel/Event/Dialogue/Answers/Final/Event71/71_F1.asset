  m_Name: 71_F1
  m_EditorClassIdentifier: Naussilus.Core::Naussilus.Core.VisualNovels.EventDatas.DialogueDatas.Answers.FinalAnswerData
  <ButtonText>k__BackingField: "Garde ces pens\xE9es pour toi, elle pourrait \xEAtre
    tr\xE8s blessantes pour elle."
  <NpcText>k__BackingField:
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 3d35d0e1530830e42b12a5e80d0329dc, type: 2}
    <Text>k__BackingField:
    - "J\u2019avais pas pr\xE9vu de lui dire, je voulais juste savoir si vous partagiez
      mon avis\u2026 "
  - <Npc>k__BackingField: {fileID: 11400000, guid: 4db0d9531338cfe4ea4e57a3339c89c1, type: 2}
    <Expression>k__BackingField: {fileID: 11400000, guid: 15a032d1f64921b49a6cec6c0a26887d, type: 2}
    <Text>k__BackingField:
    - "Mais je pense que je suis pas le seul \xE0 penser \xE7a."
  <Effects>k__BackingField:
  - <IsEnumeration>k__BackingField: 0
    <CurrentNpcTarget>k__BackingField:
      rid: -2
    <Conditions>k__BackingField: []
