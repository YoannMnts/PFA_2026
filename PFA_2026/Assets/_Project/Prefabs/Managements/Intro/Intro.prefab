      value: TextList
      objectReference: {fileID: 0}
    - target: {fileID: 5022528849125260736, guid: 3dac0a170cadbe1408a9dc29a6dca251, type: 3}
      propertyPath: m_text
      value: "Le Naussilus a d\xE9col\xE9 vers sa destination, la travers\xE9e devrait
        durer une quinzaine de jours. \n\nLa marchandise de poisson vol\xE9s est
        bien cach\xE9e dans la cale, et Ynna a tout r\xE8gl\xE9 avec le client. J'esp\xE8re
        pouvoir assurer la livraison sans encombres.\n\nC'est un tout nouvel \xE9quipage
        que j'ai d\xFB former, j'esp\xE8re que ces pirates amateurs vont bien s'entendre.
        \n"
      objectReference: {fileID: 0}
    - target: {fileID: 5022528849125260736, guid: 3dac0a170cadbe1408a9dc29a6dca251, type: 3}
      propertyPath: m_fontSize
